      "training_refinement_steps": 1,
      "edge_weight": 4.0,
      "steps": 2000
    },
    {
      "id": "arm_c_k3_edge1",
      "training_refinement_steps": 3,
      "edge_weight": 1.0,
      "steps": 2000
    },
    {
      "id": "arm_d_k3_edge4",
      "training_refinement_steps": 3,
      "edge_weight": 4.0,
      "steps": 2000
    }
  ],
  "acceptance": {
    "primary_split": "val",
    "primary_metric": "point_rel",
