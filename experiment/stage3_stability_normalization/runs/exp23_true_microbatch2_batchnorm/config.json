{
  "experiment_id": "exp23_true_microbatch2_batchnorm",
  "objective": "保持global batch与优化不变，仅将真实microbatch从1提高到2，检验跨图像BatchNorm统计。",
  "baseline": "experiment/stage2_training_strategy/runs/exp15_detached_head_ssr_coadaptation",
  "data": {
    "source": "experiment/stage2_training_strategy/runs/exp11_hypersim_100_train_staged_joint_overfit/data",
    "train": 100,
    "validation": 16,
    "test": 16,
    "augmentation": false
  },
  "training": {
    "normalization": "batch_norm",
    "resolution": [384, 512],
    "num_tokens": 2500,
    "steps": 200,
    "refinement_steps": 3,
    "global_batch_size": 8,
    "microbatch_size": 2,
    "gradient_accumulation_steps": 4,
    "dino_frozen": true,
    "head_learning_rate": 1e-6,
    "ssr_learning_rate": 2e-5,
    "weight_decay": 0.01,
    "gradient_clip_norm": 1.0,
    "refiner_detach_steps": 200,
    "seed": 151
  },
  "evaluation": {
    "steps": [0, 1, 3, 5],
    "residual_threshold": 0.5,
    "splits": ["train", "val", "test"]
  },
  "monitoring": {
    "interval_seconds": 600,
    "minimum_free_memory_mib": 30000,
    "do_not_terminate_other_jobs": true
  }
}
