    "base_frozen": true,
    "height": 384,
    "width": 512,
    "num_tokens": 2500,
    "evaluation_refinement_steps": [0, 1, 3, 5],
    "steps": 2000,
    "batch_size": 2,
    "microbatch_size": 1,
    "learning_rate": 0.00002,
    "weight_decay": 0.01,
    "global_weight": 1.0,
    "local_weight": 1.0,
    "local_scales": [4, 16, 64],
