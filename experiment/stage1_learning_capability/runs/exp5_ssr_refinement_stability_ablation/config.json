{
  "experiment_id": "exp5_ssr_refinement_stability_ablation",
  "date": "2026-07-26",
  "hypothesis": "Reducing the training refinement count to K=1 and/or strengthening the edge loss can preserve held-out boundaries while retaining an SSR point-map improvement.",
  "paper_relation": {
    "reference": "The paper trains with K=3 and supervises every intermediate point map.",
    "ablation": "This screen changes training K and the edge-loss weight while keeping the frozen base model, data, optimizer, sampling seed, resolution, and evaluation protocol fixed."
  },
  "data": {
    "manifest": "../exp4_hypersim_multiscene_generalization/data/manifest.json",
    "train_frames": 320,
    "validation_frames": 64,
    "test_frames": 64,
    "scene_groups_disjoint": true,
    "normal_data_used": false
  },
  "common": {
