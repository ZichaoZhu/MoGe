{
  "experiment_id": "exp24_microbatch2_long_detached",
  "objective": "从Exp23 step200原样续训到step800，与Exp15同强度比较BatchNorm离群和SSR收益。",
  "resume": {
    "experiment": "exp23_true_microbatch2_batchnorm",
    "step": 200,
    "optimizer": true,
    "rng": true
  },
  "baseline": {
    "experiment": "exp15_detached_head_ssr_coadaptation",
    "step": 800,
    "microbatch_size": 1
  },
  "training": {
    "normalization": "batch_norm",
    "resolution": [384, 512],
    "num_tokens": 2500,
    "start_step": 200,
    "end_step": 800,
    "refinement_steps": 3,
    "global_batch_size": 8,
    "microbatch_size": 2,
    "gradient_accumulation_steps": 4,
    "head_learning_rate": 1e-6,
    "ssr_learning_rate": 2e-5,
    "refiner_detach_steps": 800,
    "seed": 151
  },
  "evaluation": {
    "steps": [0, 1, 3, 5],
    "residual_threshold": 0.5,
    "splits": ["train", "val", "test"]
  },
  "monitoring": {
    "interval_seconds": 600,
    "minimum_free_memory_mib": 30000,
    "do_not_terminate_other_jobs": true
  }
}
